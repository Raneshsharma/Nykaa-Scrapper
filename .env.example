# ---- Nykaa intelligence pipeline config ----
# Leave DATABASE_URL blank to use the local SQLite file (nykaa_intel.db) for testing.
# Set it to your Supabase Postgres connection string to store in the cloud.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI (use the
# "Connection pooling" / Transaction pooler URI, port 6543, and put your DB password in).
# Example:
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Calibration factor: estimated units sold per new review. Only a fraction of
# buyers leave reviews, so this scales review-growth into a sales estimate.
# Start ~20 and tune once you have real multi-day history.
REVIEW_SALES_MULT=20

# Optional: path for the local SQLite file when DATABASE_URL is not set.
NYKAA_DB=nykaa_intel.db
